# Railway 배포 환경변수
# 이 파일을 참고하여 Railway 대시보드에서 환경변수를 설정하세요

# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://default:password@host:6379

# AI API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Stripe (글로벌 결제)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Toss Payments (한국 결제)
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# Auth
JWT_SECRET=your-super-secret-jwt-key-here

# CORS (프론트엔드 도메인)
CORS_ORIGINS=https://your-app.vercel.app

# Auth toggle
DISABLE_AUTH=false
