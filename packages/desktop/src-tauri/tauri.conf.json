{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube AI Agent Agency",
  "version": "0.1.0",
  "identifier": "co.hakhamsolution.ytai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "YouTube AI Agent Agency",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:8000; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": ["resources/docker-compose.desktop.yml"]
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER — tauri signer generate 실행 후 공개키로 교체",
      "endpoints": [
        "https://github.com/VetEngineer/Youtube-AI-Agent-Agency/releases/latest/download/latest.json"
      ]
    }
  }
}
