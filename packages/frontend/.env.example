# ============================================
# Frontend 환경변수 설정
# ============================================
# 이 파일을 .env.local로 복사하여 사용하세요.
# cp .env.example .env.local

# --- API 설정 ---
# 백엔드 API 기본 URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- NextAuth 설정 ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# --- Kakao OAuth ---
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_CLIENT_ID=
# 카카오 디벨로퍼스 → 제품 설정 → 카카오 로그인 → 보안 → Client Secret
KAKAO_CLIENT_SECRET=

# --- 베타 우회 로그인 ---
# 베타 테스터 / 디버깅용 접근 코드 (미설정 시 우회 로그인 비활성화)
BYPASS_LOGIN_SECRET=

# --- TossPayments (한국 결제) ---
# 백엔드 환경변수(TOSS_CLIENT_KEY, TOSS_SECRET_KEY)에서 관리
NEXT_PUBLIC_TOSS_CLIENT_KEY=
