# OCI 배포 환경변수
# 이 파일을 .env.oracle로 복사 후 값 입력

# Database (Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379

# AI Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Auth
JWT_SECRET=
INTERNAL_API_SECRET=  # NextAuth ↔ FastAPI 내부 통신 (랜덤 32자+)
ADMIN_EMAILS=vet_engineer_k@kakao.com  # 관리자 이메일 (쉼표 구분)

# NextAuth (프론트엔드 컨테이너용)
NEXTAUTH_SECRET=  # 랜덤 32자+ (openssl rand -base64 32)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# CORS (Vercel 배포 후 URL 입력)
CORS_ORIGINS=https://yaa.vercel.app

# Toss (발급 후 입력)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

DISABLE_AUTH=false
