# ============================================
# YouTube AI Agent Agency - 환경변수 설정
# ============================================
# 이 파일을 .env로 복사하여 실제 값을 입력하세요.
# cp .env.example .env

# --- LLM API 키 ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- 음성/미디어 ---
ELEVENLABS_API_KEY=...

# --- 웹 검색 ---
TAVILY_API_KEY=tvly-...

# --- YouTube API ---
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...

# --- 기본 설정 ---
CHANNELS_DIR=./channels
LOG_LEVEL=INFO
LOG_FORMAT=text  # json | text (프로덕션 권장: json)

# --- RAG (벡터 검색) ---
RAG_ENABLED=false
RAG_PERSIST_DIR=./data/chroma

# --- 데이터베이스 ---
# 개발: sqlite+aiosqlite:///./data/agency.db (기본값)
# Docker: postgresql+asyncpg://agency:password@db:5432/youtube_agency
DATABASE_URL=sqlite+aiosqlite:///./data/agency.db

# --- 인증 ---
# true로 설정하면 API 키 인증을 비활성화합니다 (개발용만, 프로덕션 금지)
DISABLE_AUTH=false
# JWT_SECRET=your-jwt-secret-here
# INTERNAL_API_SECRET=your-internal-api-secret-here  # NextAuth ↔ FastAPI 내부 통신
# ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PIPELINE_PER_MINUTE=10

# --- CORS ---
# 쉼표로 구분하여 여러 origin 설정 가능
CORS_ORIGINS=http://localhost:3000

# --- Docker PostgreSQL ---
DB_PASSWORD=localdevpassword
